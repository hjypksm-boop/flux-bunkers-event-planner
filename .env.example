# --- AI (optional) ---------------------------------------------------------
# Without a key the app uses deterministic templates for briefs, debriefs and learnings.
GROQ_API_KEY=
# Any current Groq chat model that supports JSON mode. Faster alternative: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# --- Role passwords -------------------------------------------------------------
# If unset, demo defaults are used (flux-ceo, flux-cco, flux-ssm, flux-ops) and shown on the login screen.
PASSWORD_CEO=
PASSWORD_CCO=
PASSWORD_SSM=
PASSWORD_OPS=

# --- Demo clock -------------------------------------------------------------------
# IBIA 2026 is in the future, so the demo freezes "now" mid-convention. Set to off for real time.
DEMO_CLOCK=on
DEMO_NOW=2026-12-02T15:30:00-05:00

# --- Storage (optional) ---------------------------------------------------------
# FLUX_DB_PATH=data/flux_bunkers.db
